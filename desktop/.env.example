# Backend URL. Khi build production, nhớ đổi sang IP/domain thực của server.
# Ví dụ: VITE_BACKEND_URL=http://192.168.1.100:8000
VITE_BACKEND_URL=http://localhost:8000

# Phải trùng với API_TOKEN của backend. Để trống nếu backend chưa bật auth.
# Lưu ý: giá trị này nằm trong bản build của app.
VITE_API_TOKEN=
