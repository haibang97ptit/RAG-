{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOP AI Assistant",
  "version": "0.1.0",
  "identifier": "com.internal.sopassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SOP AI Assistant",
        "width": 420,
        "height": 620,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Internal use only",
    "category": "Productivity",
    "shortDescription": "SOP AI Assistant",
    "longDescription": "Internal AI assistant for SOP documents"
  }
}
