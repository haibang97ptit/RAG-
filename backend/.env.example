# ============================================
# Groq API - BẮT BUỘC
# ============================================
GROQ_API_KEY=gsk_paste_your_key_here

# ============================================
# Qdrant
# ============================================
QDRANT_URL=http://localhost:6333

# ============================================
# Server
# ============================================
PORT=8000
NODE_ENV=development

# ============================================
# Collection
# ============================================
COLLECTION_NAME=sop_documents

# ============================================
# LLM Models
# ============================================
LLM_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b

# ============================================
# Embedding
# ============================================
EMBED_MODEL=Xenova/multilingual-e5-base

# ============================================
# Chunking
# ============================================
# Embedding model cắt input ở 512 token → giữ chunk <= ~1200 ký tự.
# Đổi giá trị này phải index lại toàn bộ.
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ============================================
# Retrieval
# ============================================
TOP_K=20
RERANK_TOP_K=10
# true = bật HyDE + query expansion (tốn thêm token)
ENHANCED_RETRIEVAL=false

# Khi user gọi tắt mã tài liệu ("SOP 0005") mà nhiều phòng ban có mã trùng số,
# hiểu là tài liệu của phòng ban này (= tên thư mục cấp 1 trong DATA_DIR). Trống = giữ tất cả.
DEFAULT_CATEGORY=QA

# ============================================
# Auth
# ============================================
# API_TOKEN: bảo vệ /query và /query/stream (app desktop gửi qua VITE_API_TOKEN).
# Để trống = KHÔNG bật auth. Tạo token: openssl rand -hex 32
API_TOKEN=
# ADMIN_TOKEN: bảo vệ /stats
ADMIN_TOKEN=change_me_to_random_string_32chars
# Giới hạn origin được gọi API (cách nhau bằng dấu phẩy). Để trống = mọi origin.
CORS_ORIGINS=

# ============================================
# Cache & Data folders
# ============================================
CACHE_DIR=./.cache
DATA_DIR=./data
# Thư mục chứa manifest của incremental ingest (mặc định: thư mục cha của DATA_DIR).
# Trên Docker phải trỏ vào volume để không mất khi recreate container.
# MANIFEST_DIR=
