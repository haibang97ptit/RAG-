{
  "name": "sop-search-backend",
  "version": "1.0.0",
  "description": "SOP Search Backend - Fastify + Qdrant + Groq",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "npx tsx src/server.ts",
    "ingest": "npx tsx src/ingest.ts",
    "ingest:reset": "npx tsx src/ingest.ts --reset",
    "ingest:incremental": "npx tsx src/incrementalIngest.ts",
    "qualzen:explore": "npx tsx src/qualzenExplore.ts",
    "qualzen:smoke": "npx tsx src/qualzenSmoke.ts",
    "eval:router": "npx tsx src/routerEval.ts",
    "feedback:report": "npx tsx src/feedbackReport.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@qdrant/js-client-rest": "^1.12.0",
    "@types/diff": "7.0.2",
    "@xenova/transformers": "2.17.2",
    "cheerio": "^1.0.0",
    "diff": "7.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "groq-sdk": "^0.9.1",
    "mammoth": "^1.8.0",
    "mssql": "^11.0.2",
    "pdf-parse": "^1.1.1",
    "pino-pretty": "^11.3.0",
    "sharp": "0.33.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
